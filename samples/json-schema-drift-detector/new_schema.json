{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderCreated",
  "type": "object",
  "required": ["order_id", "amount", "status"],
  "properties": {
    "order_id": {"type": "string"},
    "amount": {"type": "string"},
    "currency": {"type": "string", "enum": ["USD", "EUR", "GBP"]},
    "status": {"type": "string", "enum": ["PENDING", "PAID"]},
    "customer": {
      "type": "object",
      "required": [],
      "properties": {
        "email": {"type": "string"},
        "vip": {"type": "boolean"},
        "loyalty_tier": {"type": "integer"}
      }
    }
  }
}
