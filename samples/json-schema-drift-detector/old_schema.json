{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderCreated",
  "type": "object",
  "required": ["order_id", "amount"],
  "properties": {
    "order_id": {"type": "string"},
    "amount": {"type": "number"},
    "currency": {"type": "string", "enum": ["USD", "EUR"]},
    "customer": {
      "type": "object",
      "required": ["email"],
      "properties": {
        "email": {"type": "string"},
        "vip": {"type": "boolean"}
      }
    }
  }
}
